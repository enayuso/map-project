# Copy to backend/.env (gitignored) and set a real value before deploying
# anywhere beyond this dev machine. docker-compose.yml falls back to the
# dev-only default below when this file/var isn't present, so local dev
# works with zero setup.
#
# IMPORTANT: sharing/.env's DB_PASSWORD must be set to this exact same
# value — sharing/ connects to this same Postgres instance over the
# Docker network, not a separate database.
POSTGRES_PASSWORD=devpass123
