# Copy to sharing/.env (gitignored) and set a real value before deploying
# anywhere beyond this dev machine.
#
# IMPORTANT: this MUST match backend/.env's POSTGRES_PASSWORD exactly —
# this service connects to that same shared Postgres instance, not a
# separate database.
DB_PASSWORD=devpass123

# Shared secret for the /admin moderation page (approve/reject POI
# corrections, dismiss/remove hazard reports) — see main.py's
# require_admin. Leave unset to keep those routes locked out entirely;
# set a long random value (e.g. `openssl rand -hex 32`) to use the page.
ADMIN_TOKEN=
